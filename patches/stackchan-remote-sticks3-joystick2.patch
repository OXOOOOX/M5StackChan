+void handle_joystick_settings_screen(void *pvParam)
+{
+    joystick_data_t *joystick_data = (joystick_data_t *)pvParam;
+    bool waiting_for_center        = false;
+
+    while (1) {
+        if (joystick_data->screen_mode == MODE_JOYSTICK_SETTINGS) {
+            joystick_read_xy(&joystick_data->joyX, &joystick_data->joyY);
+
+            bool joy_up_or_down = (joystick_data->joyY > Y_CENTER + DEAD_ZONE) ||
+                                  (joystick_data->joyY < Y_CENTER - DEAD_ZONE);
+
+            if (joy_up_or_down && !waiting_for_center) {
+                if (joystick_data->joystick_setting_select == JOYSTICK_SETTING_INVERT_X) {
+                    joystick_data->invert_x = !joystick_data->invert_x;
+                } else {
+                    joystick_data->invert_y = !joystick_data->invert_y;
+                }
+                joystick_save_settings(joystick_data);
+                waiting_for_center = true;
+            } else if (!joy_up_or_down) {
+                waiting_for_center = false;
+            }
+
+            if (joystick_settings_screen != NULL && lv_obj_is_valid(joystick_settings_screen)) {
+                update_joystick_settings_screen(joystick_data);
+            }
+
+            vTaskDelay(50 / portTICK_PERIOD_MS);
+        } else {
+            vTaskDelay(200 / portTICK_PERIOD_MS);
+        }
+    }
+}
