diff --git a/remote/code/package_sticks3_m5burner.cmd b/remote/code/package_sticks3_m5burner.cmd
new file mode 100644
index 0000000..73ff50d
--- /dev/null
+++ b/remote/code/package_sticks3_m5burner.cmd
@@ -0,0 +1,38 @@
+@echo off
+setlocal
+
+set "OUTPUT=StackChan-RemoteControl-StickS3-Joystick2_0x0.bin"
+if not "%~1"=="" set "OUTPUT=%~1"
+
+if "%IDF_PATH%"=="" (
+    echo IDF_PATH is not set. Run this script from an ESP-IDF Command Prompt.
+    exit /b 1
+)
+
+where python >nul 2>nul
+if errorlevel 1 (
+    echo python was not found. Run this script from an ESP-IDF Command Prompt.
+    exit /b 1
+)
+
+cd /d "%~dp0"
+python "%IDF_PATH%\tools\idf.py" set-target esp32s3
+if errorlevel 1 exit /b %errorlevel%
+
+python "%IDF_PATH%\tools\idf.py" -D SDKCONFIG_DEFAULTS=sdkconfig.defaults reconfigure
+if errorlevel 1 exit /b %errorlevel%
+
+python "%IDF_PATH%\tools\idf.py" build
+if errorlevel 1 exit /b %errorlevel%
+
+if not exist "build\flash_args" (
+    echo build\flash_args was not generated.
+    exit /b 1
+)
+
+cd /d "%~dp0build"
+python -m esptool --chip esp32s3 merge_bin -o "..\%OUTPUT%" @flash_args
+if errorlevel 1 exit /b %errorlevel%
+
+echo Created M5Burner image: %~dp0%OUTPUT%
+endlocal
diff --git a/remote/code/package_sticks3_m5burner.ps1 b/remote/code/package_sticks3_m5burner.ps1
new file mode 100644
index 0000000..ae62a75
--- /dev/null
+++ b/remote/code/package_sticks3_m5burner.ps1
@@ -0,0 +1,33 @@
+param(
+    [string]$Output = "StackChan-RemoteControl-StickS3-Joystick2_0x0.bin"
+)
+
+$ErrorActionPreference = "Stop"
+
+if (-not (Get-Command idf.py -ErrorAction SilentlyContinue)) {
+    throw "idf.py was not found. Run this script from an ESP-IDF PowerShell/Command Prompt."
+}
+
+if (-not (Get-Command esptool.py -ErrorAction SilentlyContinue)) {
+    throw "esptool.py was not found. Run this script from an ESP-IDF PowerShell/Command Prompt."
+}
+
+idf.py set-target esp32s3
+idf.py -D SDKCONFIG_DEFAULTS=sdkconfig.defaults reconfigure
+idf.py build
+
+$flashArgs = Join-Path $PSScriptRoot "build\flash_args"
+if (-not (Test-Path $flashArgs)) {
+    throw "build\flash_args was not generated."
+}
+
+$outputPath = Join-Path $PSScriptRoot $Output
+Push-Location (Join-Path $PSScriptRoot "build")
+try {
+    esptool.py --chip esp32s3 merge_bin -o $outputPath "@flash_args"
+}
+finally {
+    Pop-Location
+}
+
+Write-Host "Created M5Burner image: $outputPath"
