+static constexpr uint8_t DISPLAY_BRIGHTNESS_NORMAL = 35;
+static constexpr uint8_t DISPLAY_BRIGHTNESS_LOW_BAT = 18;
+static constexpr uint8_t DISPLAY_BRIGHTNESS_CHARGING = 12;
+static constexpr int8_t LOW_BATTERY_ENTER_THRESHOLD = 22;
+static constexpr int8_t LOW_BATTERY_EXIT_THRESHOLD = 32;
+static constexpr TickType_t POWER_PROFILE_STABLE_TICKS = pdMS_TO_TICKS(5000);
+
+enum power_display_mode_t : uint8_t {
+    POWER_DISPLAY_NORMAL,
+    POWER_DISPLAY_LOW_BATTERY,
+    POWER_DISPLAY_CHARGING,
+};
+
+static uint8_t brightness_for_mode(power_display_mode_t mode)
+{
+    switch (mode) {
+    case POWER_DISPLAY_CHARGING:
+        return DISPLAY_BRIGHTNESS_CHARGING;
+    case POWER_DISPLAY_LOW_BATTERY:
+        return DISPLAY_BRIGHTNESS_LOW_BAT;
+    case POWER_DISPLAY_NORMAL:
+    default:
+        return DISPLAY_BRIGHTNESS_NORMAL;
+    }
+}
+
+static void apply_power_profile(int8_t battery_level, bool charging)
+{
+    static uint8_t current_brightness = 0xFF;
+    static power_display_mode_t active_mode = POWER_DISPLAY_NORMAL;
+    static power_display_mode_t pending_mode = POWER_DISPLAY_NORMAL;
+    static TickType_t pending_since = 0;
+    static bool low_battery_mode = false;
+    static bool initialized = false;
+
+    if (battery_level > 0) {
+        if (battery_level <= LOW_BATTERY_ENTER_THRESHOLD) {
+            low_battery_mode = true;
+        } else if (battery_level >= LOW_BATTERY_EXIT_THRESHOLD) {
+            low_battery_mode = false;
+        }
+    }
+
+    power_display_mode_t requested_mode = POWER_DISPLAY_NORMAL;
+    if (charging) {
+        requested_mode = POWER_DISPLAY_CHARGING;
+    } else if (low_battery_mode) {
+        requested_mode = POWER_DISPLAY_LOW_BATTERY;
+    }
+
+    TickType_t now = xTaskGetTickCount();
+    if (!initialized) {
+        active_mode = requested_mode;
+        pending_mode = requested_mode;
+        initialized = true;
+    } else if (requested_mode == active_mode) {
+        pending_mode = requested_mode;
+        pending_since = now;
+    } else if (requested_mode != pending_mode) {
+        pending_mode = requested_mode;
+        pending_since = now;
+    } else if ((now - pending_since) >= POWER_PROFILE_STABLE_TICKS) {
+        active_mode = requested_mode;
+    }
+
+    uint8_t target_brightness = brightness_for_mode(active_mode);
+    if (current_brightness != target_brightness) {
+        M5.Display.setBrightness(target_brightness);
+        current_brightness = target_brightness;
+    }
+}
