+#include "ui_joystick_settings_screen.h"
+#include "../lvgl_port.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+lv_obj_t *joystick_settings_screen = NULL;
+static lv_obj_t *invert_x_label    = NULL;
+static lv_obj_t *invert_y_label    = NULL;
+
+static const char *onoff(bool value)
+{
+    return value ? "ON" : "OFF";
+}
+
+void create_joystick_settings_screen(void)
+{
+    while (!lvgl_port_lock()) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+
+    if (joystick_settings_screen == NULL) {
+        joystick_settings_screen = lv_obj_create(NULL);
+    }
+    lv_obj_clear_flag(joystick_settings_screen, LV_OBJ_FLAG_SCROLLABLE);
+
+    lv_obj_t *title = lv_label_create(joystick_settings_screen);
+    lv_label_set_text(title, "Joystick Settings");
+    lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 10);
+    lv_obj_set_style_text_font(title, &lv_font_montserrat_14, 0);
+
+    invert_x_label = lv_label_create(joystick_settings_screen);
+    lv_obj_align(invert_x_label, LV_ALIGN_TOP_LEFT, 10, 55);
+    lv_obj_set_style_text_font(invert_x_label, &lv_font_montserrat_14, 0);
+
+    invert_y_label = lv_label_create(joystick_settings_screen);
+    lv_obj_align(invert_y_label, LV_ALIGN_TOP_LEFT, 10, 85);
+    lv_obj_set_style_text_font(invert_y_label, &lv_font_montserrat_14, 0);
+
+    lv_obj_t *hint = lv_label_create(joystick_settings_screen);
+    lv_label_set_text(hint, "B Select\nJoy Up/Down Toggle\nA Back");
+    lv_obj_align(hint, LV_ALIGN_TOP_LEFT, 10, 135);
+    lv_obj_set_style_text_font(hint, &lv_font_montserrat_14, 0);
+
+    lvgl_port_unlock();
+}
+
+void update_joystick_settings_screen(const joystick_data_t *data)
+{
+    while (!lvgl_port_lock()) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+
+    lv_label_set_text_fmt(invert_x_label, "%s Invert X: %s",
+                          data->joystick_setting_select == JOYSTICK_SETTING_INVERT_X ? ">" : " ",
+                          onoff(data->invert_x));
+    lv_label_set_text_fmt(invert_y_label, "%s Invert Y: %s",
+                          data->joystick_setting_select == JOYSTICK_SETTING_INVERT_Y ? ">" : " ",
+                          onoff(data->invert_y));
+
+    lvgl_port_unlock();
+}
+
+void ui_joystick_settings_screen_destory(void)
+{
+    while (!lvgl_port_lock()) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+
+    if (joystick_settings_screen != NULL) {
+        lv_obj_del(joystick_settings_screen);
+        joystick_settings_screen = NULL;
+    }
+
+    lvgl_port_unlock();
+    invert_x_label = NULL;
+    invert_y_label = NULL;
+}
