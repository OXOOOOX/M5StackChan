+static uint16_t maybe_invert_axis(uint16_t value, bool invert, uint16_t min_value, uint16_t max_value)
+{
+    if (!invert) {
+        return value;
+    }
+    return (uint16_t)((uint32_t)min_value + (uint32_t)max_value - (uint32_t)value);
+}
+
+static uint16_t clamp_u16(uint32_t value, uint16_t min_value, uint16_t max_value)
+{
+    if (value < min_value) {
+        return min_value;
+    }
+    if (value > max_value) {
+        return max_value;
+    }
+    return (uint16_t)value;
+}
+
+static int16_t clamp_i16(int32_t value, int16_t min_value, int16_t max_value)
+{
+    if (value < min_value) {
+        return min_value;
+    }
+    if (value > max_value) {
+        return max_value;
+    }
+    return (int16_t)value;
+}
+
+static uint16_t apply_deadzone_u16(uint16_t value, uint16_t center, uint16_t deadzone)
+{
+    int32_t delta = (int32_t)value - (int32_t)center;
+    if (delta > -(int32_t)deadzone && delta < (int32_t)deadzone) {
+        return center;
+    }
+    return value;
+}
+
+static int16_t map_axis_u16_to_i16(uint16_t value, uint16_t in_min, uint16_t in_max, int16_t out_min, int16_t out_max)
+{
+    int32_t mapped = ((int32_t)value - (int32_t)in_min) * ((int32_t)out_max - (int32_t)out_min) /
+                         ((int32_t)in_max - (int32_t)in_min) +
+                     (int32_t)out_min;
+    int16_t clamp_min = (out_min < out_max) ? out_min : out_max;
+    int16_t clamp_max = (out_min < out_max) ? out_max : out_min;
+    return clamp_i16(mapped, clamp_min, clamp_max);
+}
+
+static void joystick_load_settings(joystick_data_t *data)
+{
+    nvs_handle_t handle;
+    esp_err_t ret = nvs_open(JOYSTICK_NVS_NAMESPACE, NVS_READONLY, &handle);
+    if (ret != ESP_OK) {
+        return;
+    }
+
+    uint8_t value = 0;
+    if (nvs_get_u8(handle, JOYSTICK_NVS_INVERT_X, &value) == ESP_OK) {
+        data->invert_x = (value != 0);
+    }
+    if (nvs_get_u8(handle, JOYSTICK_NVS_INVERT_Y, &value) == ESP_OK) {
+        data->invert_y = (value != 0);
+    }
+
+    nvs_close(handle);
+}
+
+static void joystick_save_settings(const joystick_data_t *data)
+{
+    nvs_handle_t handle;
+    esp_err_t ret = nvs_open(JOYSTICK_NVS_NAMESPACE, NVS_READWRITE, &handle);
+    if (ret != ESP_OK) {
+        ESP_LOGE("Joystick", "Failed to open NVS: %s", esp_err_to_name(ret));
+        return;
+    }
+
+    ret = nvs_set_u8(handle, JOYSTICK_NVS_INVERT_X, data->invert_x ? 1 : 0);
+    ret |= nvs_set_u8(handle, JOYSTICK_NVS_INVERT_Y, data->invert_y ? 1 : 0);
+    if (ret == ESP_OK) {
+        ret = nvs_commit(handle);
+    }
+    if (ret != ESP_OK) {
+        ESP_LOGE("Joystick", "Failed to save settings: %s", esp_err_to_name(ret));
+    }
+
+    nvs_close(handle);
+}
